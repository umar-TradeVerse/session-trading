# ── SAFETY ──────────────────────────────────────────────────────────────
# Leave this true until you have watched a full week of signals.
DRY_RUN=true

# ── CoinDCX (Futures wallet must be funded, not Spot) ───────────────────
COINDCX_API_KEY=
COINDCX_API_SECRET=

# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Market ──────────────────────────────────────────────────────────────
PAIR=B-BTC_USDT
LEVERAGE=10
MARGIN_CURRENCY=INR        # INR or USDT: whichever FUTURES wallet holds your funds
MARGIN_TYPE=isolated
# Contract spec. These match CoinDCX's B-BTC_USDT today, and the bot re-reads the
# real values from the exchange every time it starts.
QTY_STEP=0.001
PRICE_STEP=0.1
MIN_QTY=0.001
MIN_NOTIONAL_USDT=60

# ── Money ───────────────────────────────────────────────────────────────
CAPITAL_INR=5000
RISK_PER_TRADE_INR=100
USDINR=88

# ── SL / TP (defaults are the backtested values) ────────────────────────
SL_LEVEL_BUFFER=0.0015
SL_LEVEL_BUFFER_SA2=0.0045
PARTIAL_TP_R=0.50
PARTIAL_TP_FRAC=0.50
TRAIL_AFTER_R=0.50
TRAIL_STEP_R=0.25
BREAKEVEN_AT_R=1.00
BREAKEVEN_PLUS_PCT=0.0016

# ── Detection ───────────────────────────────────────────────────────────
CLEAR_CLOSE_STRENGTH=0.50
CLEAR_TOUCH_TOLERANCE=0.15
TAP_TOLERANCE=0.0006
MOMENTUM_WINDOW=2

# ── Costs — CONFIRM these against your CoinDCX account ──────────────────
TAKER_FEE=0.00059
MAKER_FEE=0.0
SLIPPAGE=0.0002
FUNDING_RATE_8H=0.0001

# ── Circuit breakers ────────────────────────────────────────────────────
DAILY_LOSS_LIMIT_INR=500
MAX_CONSEC_LOSSES=4        # losses in a row, counted across days
HALT_DAYS=1                # after a streak, skip this many extra days

# ── Entry timing ────────────────────────────────────────────────────────
# Skip a signal if the bot is later than this to act on it (restart, outage).
MAX_ENTRY_LAG_SECONDS=90

# ── Runtime ─────────────────────────────────────────────────────────────
POLL_SECONDS=20
LOG_LEVEL=INFO

# ── Optional rules. All OFF by default (the baseline). Turn on only after testing them. ──
SA1_REQUIRE_CLEAN=false        # SA1: a candle touching the line is not a clear breakout
SA2_STRICT_REJECTION=false     # SA2: only doji / long-wick rejections count
VETO_MODE=off                  # off | next_candle | sa4_style   (wait before entering SA1/SA2)
VETO_AGENTS=SA1,SA2
